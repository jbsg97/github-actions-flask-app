{
    "family": "dev-simple-flask-app",
    "containerDefinitions": [
        {
            "name": "simple-flask-app",
            "image": "628247745652.dkr.ecr.us-east-1.amazonaws.com/simple-flask-app:latest",
            "cpu": 256,
            "memory": 512,
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "FLASK_ENV",
                    "value": "production"
                }
            ]
        }
    ],
    "requiresCompatibilities": ["EC2"],
    "networkMode": "bridge",
    "cpu": "256",
    "memory": "512"
}
